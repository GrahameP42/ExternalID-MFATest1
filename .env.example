# Local dev hostname — must match the auth.<tenant>.ciamlogin.com entry in your hosts file
# Example: auth.passkeytest2.ciamlogin.com
VITE_HOST=auth.<your-tenant-subdomain>.ciamlogin.com
VITE_PORT=3000

# Tenant and app registration values (output by scripts/01-Setup-Entra.ps1)
VITE_TENANT_ID=<your-tenant-id-guid>
VITE_CIAM_DOMAIN=<your-tenant-subdomain>.ciamlogin.com
VITE_CLIENT_ID=<your-app-client-id-guid>

# SSL certificate filenames (generated by scripts/02-Setup-LocalDev.ps1 — placed at project root)
VITE_SSL_CERT=auth-cert.pem
VITE_SSL_KEY=auth-key.pem

# Client secret from your Entra app registration (DO NOT COMMIT)
VITE_APP_SECRET=<your-client-secret>

# Optional: custom URL domain (leave empty to use ciamlogin.com rp.id)
VITE_CUSTOM_DOMAIN=
